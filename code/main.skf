// skyforge-bank-card

функция только_цифры(карта) {
    пусть результат = ""
    для с в строка_символы(карта) {
        если цифра(с) { результат = результат + с }
    }
    вернуть результат
}

функция луна_проверка(карта) {
    пусть d = только_цифры(карта)
    если длина(d) < 12 { вернуть ложь }
    
    пусть сумма = 0
    пусть позиция = 0
    пусть n = длина(d) - 1
    
    для i от 0 до n {
        пусть индекс = n - i
        пусть символ = подстрока(d, индекс, индекс + 1)
        пусть цифра_значение = число(символ)
        
        если позиция % 2 == 1 {
            цифра_значение = цифра_значение * 2
            если цифра_значение > 9 {
                цифра_значение = цифра_значение - 9
            }
        }
        
        сумма = сумма + цифра_значение
        позиция = позиция + 1
    }
    
    вернуть сумма % 10 == 0
}

функция это_карта(карта) {
    пусть d = только_цифры(карта)
    если длина(d) < 13 или длина(d) > 19 { вернуть ложь }
    вернуть луна_проверка(d)
}
